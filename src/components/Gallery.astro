---
---

<section id="galeria" class="py-24 relative" style="background-color: #E8E2D9;">
  <div class="max-w-7xl mx-auto px-4 md:px-6 w-full">
    
    <!-- Section Header (with Eyebrow - allowed here as the 5th section) -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="reveal-on-scroll mb-4">
        <span class="inline-flex items-center rounded-full border border-accent/20 bg-accent/5 px-3.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">
          Santuario en Imágenes
        </span>
      </div>
      <h2 class="reveal-on-scroll font-serif text-3xl md:text-4xl text-primary font-bold tracking-tight mb-4">
        Galería de Relajación
      </h2>
      <p class="reveal-on-scroll text-sm text-charcoal/70 font-sans leading-relaxed">
        Explora la atmósfera de paz y restauración física diseñada especialmente para tu bienestar.
      </p>
    </div>

    <!-- Asymmetrical Bento Grid (3 columns, 3 rows on desktop) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[220px]">
      
      <!-- Cell 1: Pool (Spans 2 cols, 2 rows) -->
      <div class="reveal-on-scroll md:col-span-2 md:row-span-2 rounded-[2rem] border border-charcoal/5 p-1.5 bg-sand/30 hover:shadow-md transition-shadow duration-500">
        <div class="w-full h-full rounded-[calc(2rem-0.375rem)] overflow-hidden relative group">
          <img 
            src="/assets/gallery_1.webp" 
            alt="Área de relajación y piscina" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1500ms] ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6">
            <span class="text-xs uppercase tracking-widest text-cream font-semibold">Piscina de Relajación</span>
          </div>
        </div>
      </div>

      <!-- Cell 2: Oil Macro (Spans 1 col, 1 row) -->
      <div class="reveal-on-scroll md:col-span-1 md:row-span-1 rounded-[2rem] border border-charcoal/5 p-1.5 bg-sand/30 hover:shadow-md transition-shadow duration-500">
        <div class="w-full h-full rounded-[calc(2rem-0.375rem)] overflow-hidden relative group">
          <img 
            src="/assets/gallery_2.webp" 
            alt="Aceites esenciales orgánicos" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1500ms] ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6">
            <span class="text-xs uppercase tracking-widest text-cream font-semibold">Extractos Orgánicos</span>
          </div>
        </div>
      </div>

      <!-- Cell 3: Hot Stones (Spans 1 col, 1 row) -->
      <div class="reveal-on-scroll md:col-span-1 md:row-span-1 rounded-[2rem] border border-charcoal/5 p-1.5 bg-sand/30 hover:shadow-md transition-shadow duration-500">
        <div class="w-full h-full rounded-[calc(2rem-0.375rem)] overflow-hidden relative group">
          <img 
            src="/assets/gallery_3.webp" 
            alt="Piedras volcánicas calientes" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1500ms] ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6">
            <span class="text-xs uppercase tracking-widest text-cream font-semibold">Piedras Volcánicas</span>
          </div>
        </div>
      </div>

      <!-- Cell 4: Spa Treatment Room (Spans 1 col, 1 row) -->
      <div class="reveal-on-scroll md:col-span-1 md:row-span-1 rounded-[2rem] border border-charcoal/5 p-1.5 bg-sand/30 hover:shadow-md transition-shadow duration-500">
        <div class="w-full h-full rounded-[calc(2rem-0.375rem)] overflow-hidden relative group">
          <img 
            src="/assets/gallery_4.webp" 
            alt="Cabina de masaje minimalista" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1500ms] ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6">
            <span class="text-xs uppercase tracking-widest text-cream font-semibold">Cabinas Privadas</span>
          </div>
        </div>
      </div>

      <!-- Cell 5: Tea Ceremony (Spans 2 cols, 1 row) -->
      <div class="reveal-on-scroll md:col-span-2 md:row-span-1 rounded-[2rem] border border-charcoal/5 p-1.5 bg-sand/30 hover:shadow-md transition-shadow duration-500">
        <div class="w-full h-full rounded-[calc(2rem-0.375rem)] overflow-hidden relative group">
          <img 
            src="/assets/gallery_5.webp" 
            alt="Té relajante post-tratamiento" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1500ms] ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6">
            <span class="text-xs uppercase tracking-widest text-cream font-semibold">Ritual de Cierre</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
