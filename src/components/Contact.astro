---
---

<section id="contacto" class="py-24 border-t border-charcoal/5 relative bg-cream">
  <div class="max-w-7xl mx-auto px-4 md:px-6 w-full">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="reveal-on-scroll font-serif text-3xl md:text-4xl text-primary font-bold tracking-tight mb-4">
        Ubicación y Contacto
      </h2>
      <p class="reveal-on-scroll text-sm text-charcoal/70 font-sans leading-relaxed">
        Encuéntranos y contáctanos para resolver tus dudas o reservar tu cita personalizada.
      </p>
    </div>

    <!-- Contact Grid: Left details, Right map -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Details & Socials (4 cols on desktop) -->
      <div class="lg:col-span-4 space-y-10 text-left">
        
        <!-- Contact Info -->
        <div class="reveal-on-scroll space-y-6">
          <h3 class="font-serif text-xl font-bold text-primary">Información de Contacto</h3>
          
          <div class="space-y-5">
            <!-- Address -->
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full bg-primary-tint flex items-center justify-center text-primary shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="flex flex-col text-sm">
                <span class="font-bold font-serif text-primary mb-1">Dirección</span>
                <span class="text-charcoal/70 font-light leading-relaxed">Av. Real del Monte 102, Residencial Las Lomas, Ciudad de México, CDMX.</span>
              </div>
            </div>

            <!-- Phone / WhatsApp -->
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full bg-primary-tint flex items-center justify-center text-primary shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
              </div>
              <div class="flex flex-col text-sm">
                <span class="font-bold font-serif text-primary mb-1">WhatsApp</span>
                <a 
                  href="https://wa.me/5211234567890?text=Hola%20IKAL%20Spa,%20me%20gustar%C3%ADa%20agendar%20una%20cita." 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-charcoal/70 font-light hover:text-primary transition-colors"
                >
                  +52 1 12 3456 7890
                </a>
              </div>
            </div>

            <!-- Instagram -->
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full bg-primary-tint flex items-center justify-center text-primary shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              </div>
              <div class="flex flex-col text-sm">
                <span class="font-bold font-serif text-primary mb-1">Instagram</span>
                <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-charcoal/70 font-light hover:text-primary transition-colors">@ikalspawellness</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Hours Block -->
        <div class="reveal-on-scroll space-y-4">
          <h3 class="font-serif text-xl font-bold text-primary">Horario de Atención</h3>
          <div class="text-sm font-sans space-y-2.5">
            <div class="flex justify-between border-b border-charcoal/10 pb-2 font-light">
              <span class="text-charcoal/80">Lunes a Viernes</span>
              <span class="font-semibold text-primary">09:00 - 19:00</span>
            </div>
            <div class="flex justify-between border-b border-charcoal/10 pb-2 font-light">
              <span class="text-charcoal/80">Sábados</span>
              <span class="font-semibold text-primary">09:00 - 14:00</span>
            </div>
            <div class="flex justify-between pb-2 font-light">
              <span class="text-charcoal/80">Domingos</span>
              <span class="font-medium text-accent">Cerrado</span>
            </div>
          </div>
        </div>

        <!-- WhatsApp CTA direct -->
        <div class="reveal-on-scroll">
          <a 
            href="https://wa.me/5211234567890?text=Hola%20IKAL%20Spa,%20me%20gustar%C3%ADa%20agendar%20una%20cita%20de%20bienestar." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="group flex items-center gap-3 bg-primary text-cream rounded-full pl-6 pr-1.5 py-1.5 text-xs font-bold uppercase tracking-widest shadow-md hover:bg-primary-light hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 w-full justify-center md:w-auto md:justify-start"
          >
            <span>Agendar por WhatsApp</span>
            <div class="w-8 h-8 rounded-full bg-cream/15 flex items-center justify-center group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cream">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </a>
        </div>

      </div>

      <!-- Right Column: Google Maps Embed (8 cols on desktop) -->
      <div class="lg:col-span-8">
        <div class="reveal-on-scroll rounded-[2.5rem] border border-charcoal/5 p-2 bg-sand/35 overflow-hidden shadow-[0_16px_40px_-12px_rgba(77,96,84,0.08)]">
          <div class="w-full rounded-[calc(2.5rem-0.5rem)] overflow-hidden relative aspect-[16/9] md:aspect-[4/3] lg:aspect-[16/9]">
            <!-- Google Maps embed — using a general CDMX center as placeholder.
                 Replace the src URL with the exact iframe embed URL from Google Maps for the real address. -->
            <iframe
              title="Ubicación IKAL Spa & Wellness"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3763.1082540617556!2d-99.17225192394705!3d19.42675494101946!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85d1ff6f5a4c6879%3A0x6ea4a7fc0cfdfdb8!2sAv.%20Real%20del%20Monte%2C%20Ciudad%20de%20M%C3%A9xico%2C%20CDMX!5e0!3m2!1ses!2smx!4v1718000000000!5m2!1ses!2smx"
              width="100%"
              height="100%"
              style="border:0; position:absolute; inset:0; width:100%; height:100%;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>

            <!-- Subtle address label overlay at bottom -->
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-charcoal/60 to-transparent px-6 py-5 pointer-events-none">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cream/80">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span class="text-xs text-cream/90 font-sans font-medium">Av. Real del Monte 102, Residencial Las Lomas, CDMX</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
