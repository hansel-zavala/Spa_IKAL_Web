---
---

<footer class="bg-cream border-t border-charcoal/10 py-16 relative">
  <!-- Dynamic background glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-40 rounded-full bg-primary-tint/10 filter blur-3xl -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 md:px-6 w-full flex flex-col gap-12">
    
    <!-- Top Footer: Brand, Links, Info -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
      
      <!-- Brand Logo Section (5 cols) -->
      <div class="md:col-span-5 space-y-4 text-left">
        <a href="#" class="inline-flex items-center gap-3 group focus:outline-none">
          <div class="relative w-12 h-12 rounded-full overflow-hidden border border-accent/20 p-0.5 bg-cream">
            <img 
              src="/assets/ikal_emblem.webp" 
              alt="IKAL Emblem" 
              class="w-full h-full object-contain group-hover:rotate-12 transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]"
            />
          </div>
          <div class="flex flex-col select-none">
            <span class="font-serif text-xl font-bold tracking-widest text-primary leading-tight">IKAL</span>
            <span class="text-[9px] uppercase tracking-[0.25em] text-charcoal/80 font-semibold font-sans">Spa & Wellness</span>
            <span class="text-[7.5px] uppercase tracking-[0.15em] text-accent font-semibold font-sans mt-0.5">Grecia Lamar</span>
          </div>
        </a>
        <p class="text-xs text-charcoal/60 font-light leading-relaxed max-w-[32ch]">
          Un refugio dedicado a la curación de tu cuerpo y el descanso de tu mente, liderado por la fisioterapeuta Grecia Lamar.
        </p>
      </div>

      <!-- Quick Links (3 cols) -->
      <div class="md:col-span-3 space-y-4 text-left">
        <h4 class="text-[10px] font-bold uppercase tracking-wider text-charcoal/50">Navegación</h4>
        <ul class="space-y-2 text-xs font-sans">
          <li>
            <a href="#servicios" class="text-charcoal/80 hover:text-primary transition-colors">Servicios</a>
          </li>
          <li>
            <a href="#promociones" class="text-charcoal/80 hover:text-primary transition-colors">Promociones</a>
          </li>
          <li>
            <a href="#nosotros" class="text-charcoal/80 hover:text-primary transition-colors">Nosotros</a>
          </li>
          <li>
            <a href="#galeria" class="text-charcoal/80 hover:text-primary transition-colors">Galería</a>
          </li>
          <li>
            <a href="#contacto" class="text-charcoal/80 hover:text-primary transition-colors">Contacto</a>
          </li>
        </ul>
      </div>

      <!-- Contact Info Summary & Socials (4 cols) -->
      <div class="md:col-span-4 space-y-4 text-left">
        <h4 class="text-[10px] font-bold uppercase tracking-wider text-charcoal/50">Contacto</h4>
        <p class="text-xs text-charcoal/80 font-light font-sans">
          Av. Real del Monte 102, Residencial Las Lomas, CDMX.<br/>
          +52 1 12 3456 7890<br/>
          contacto@ikalwellness.com
        </p>
        
        <!-- Social Icons Row (Thin SVGs) -->
        <div class="flex items-center gap-4 pt-2">
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-charcoal/60 hover:text-primary transition-colors duration-300" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-charcoal/60 hover:text-primary transition-colors duration-300" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
          <a href="https://wa.me/5211234567890" target="_blank" rel="noopener noreferrer" class="text-charcoal/60 hover:text-primary transition-colors duration-300" aria-label="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Footer: Divider & Copyright -->
    <div class="border-t border-charcoal/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-[10px] text-charcoal/50 tracking-wider font-light">
        © 2026 IKAL Spa & Wellness. Todos los derechos reservados.
      </div>
      
      <!-- Back to Top Link -->
      <a 
        href="#" 
        class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-widest text-charcoal/60 hover:text-primary transition-colors"
      >
        <span>Volver Arriba</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
      </a>
    </div>

  </div>
</footer>
