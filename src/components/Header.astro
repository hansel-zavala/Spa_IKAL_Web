---
---

<header class="sticky top-4 z-50 max-w-7xl mx-auto px-4 md:px-6 w-full pointer-events-none">
  <!-- Navbar Floating Container -->
  <nav class="pointer-events-auto bg-cream/80 backdrop-blur-xl border border-charcoal/10 rounded-full px-6 py-3 flex items-center justify-between shadow-[0_8px_30px_rgb(0,0,0,0.03)] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]">
    <!-- Brand Logo Section -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none">
      <div class="relative w-11 h-11 rounded-full overflow-hidden border border-accent/20 p-0.5 bg-cream">
        <img 
          src="/assets/ikal_emblem.webp" 
          alt="IKAL Emblem" 
          class="w-full h-full object-contain group-hover:rotate-12 transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]"
        />
      </div>
      <div class="flex flex-col select-none">
        <span class="font-serif text-lg font-bold tracking-widest text-primary leading-tight">IKAL</span>
        <span class="text-[8px] uppercase tracking-[0.25em] text-charcoal/80 font-semibold font-sans">Spa & Wellness</span>
        <span class="text-[6.5px] uppercase tracking-[0.15em] text-accent font-semibold font-sans mt-0.5">Grecia Lamar</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-8">
      <a href="#servicios" class="text-xs uppercase tracking-widest font-sans font-medium text-charcoal/70 hover:text-primary transition-colors duration-300">Servicios</a>
      <a href="#promociones" class="text-xs uppercase tracking-widest font-sans font-medium text-charcoal/70 hover:text-primary transition-colors duration-300">Promociones</a>
      <a href="#nosotros" class="text-xs uppercase tracking-widest font-sans font-medium text-charcoal/70 hover:text-primary transition-colors duration-300">Nosotros</a>
      <a href="#galeria" class="text-xs uppercase tracking-widest font-sans font-medium text-charcoal/70 hover:text-primary transition-colors duration-300">Galería</a>
      <a href="#contacto" class="text-xs uppercase tracking-widest font-sans font-medium text-charcoal/70 hover:text-primary transition-colors duration-300">Contacto</a>
    </div>

    <!-- Right Actions: Socials & Reservar -->
    <div class="hidden md:flex items-center gap-5">
      <!-- Social Media Icons (Thin SVG) -->
      <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-charcoal/60 hover:text-primary transition-colors duration-300" aria-label="Instagram">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
        </svg>
      </a>
      <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-charcoal/60 hover:text-primary transition-colors duration-300" aria-label="Facebook">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
      </a>

      <!-- WhatsApp Button "Reservar" (Pill, Button-in-Button Style) -->
      <a 
        href="https://wa.me/5211234567890?text=Hola%20IKAL%20Spa,%20me%20gustar%C3%ADa%20agendar%20una%20cita%20de%20bienestar." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group flex items-center gap-3 bg-primary text-cream rounded-full pl-5 pr-1.5 py-1.5 text-xs font-semibold uppercase tracking-widest shadow-md hover:bg-primary-light hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all duration-300"
      >
        <span>Reservar</span>
        <div class="w-8 h-8 rounded-full bg-cream/15 flex items-center justify-center group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cream">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>
      </a>
    </div>

    <!-- Mobile Navigation Toggle -->
    <div class="flex md:hidden items-center gap-4">
      <a 
        href="https://wa.me/5211234567890?text=Hola%20IKAL%20Spa,%20me%20gustar%C3%ADa%20agendar%20una%20cita%20de%20bienestar." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="bg-primary text-cream rounded-full px-4 py-2 text-[10px] font-semibold uppercase tracking-widest shadow-md active:scale-95 transition-all duration-300"
      >
        Reservar
      </a>
      <button 
        id="mobile-menu-btn" 
        class="relative w-10 h-10 flex flex-col justify-center items-center rounded-full border border-charcoal/10 bg-cream text-charcoal focus:outline-none"
        aria-label="Abrir Menú"
      >
        <span id="hamburger-line-1" class="w-5 h-[1.5px] bg-charcoal rounded-full my-[2px] transition-all duration-300 ease-out"></span>
        <span id="hamburger-line-2" class="w-5 h-[1.5px] bg-charcoal rounded-full my-[2px] transition-all duration-300 ease-out"></span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Fullscreen Menu Overlay -->
<div 
  id="mobile-menu-overlay" 
  class="fixed inset-0 z-40 bg-cream/98 backdrop-blur-2xl flex flex-col justify-between p-8 pt-28 opacity-0 pointer-events-none transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
>
  <!-- Background Accent Blur -->
  <div class="absolute top-1/4 left-1/4 w-80 h-80 rounded-full bg-primary-tint/60 filter blur-3xl -z-10 animate-pulse duration-[8000ms]"></div>
  
  <!-- Navigation Links -->
  <div class="flex flex-col gap-6 text-left">
    <div class="overflow-hidden">
      <a href="#servicios" class="mobile-nav-link block text-3xl font-serif font-bold text-charcoal/80 hover:text-primary transition-colors duration-300 translate-y-12 opacity-0">Servicios</a>
    </div>
    <div class="overflow-hidden">
      <a href="#promociones" class="mobile-nav-link block text-3xl font-serif font-bold text-charcoal/80 hover:text-primary transition-colors duration-300 translate-y-12 opacity-0">Promociones</a>
    </div>
    <div class="overflow-hidden">
      <a href="#nosotros" class="mobile-nav-link block text-3xl font-serif font-bold text-charcoal/80 hover:text-primary transition-colors duration-300 translate-y-12 opacity-0">Nosotros</a>
    </div>
    <div class="overflow-hidden">
      <a href="#galeria" class="mobile-nav-link block text-3xl font-serif font-bold text-charcoal/80 hover:text-primary transition-colors duration-300 translate-y-12 opacity-0">Galería</a>
    </div>
    <div class="overflow-hidden">
      <a href="#contacto" class="mobile-nav-link block text-3xl font-serif font-bold text-charcoal/80 hover:text-primary transition-colors duration-300 translate-y-12 opacity-0">Contacto</a>
    </div>
  </div>

  <!-- Social Links and Info Footer -->
  <div class="flex flex-col gap-6 border-t border-charcoal/10 pt-6">
    <div class="flex items-center gap-6">
      <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-charcoal/70 hover:text-primary transition-colors duration-300 flex items-center gap-2 text-xs font-semibold uppercase tracking-widest">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
        </svg>
        <span>Instagram</span>
      </a>
      <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-charcoal/70 hover:text-primary transition-colors duration-300 flex items-center gap-2 text-xs font-semibold uppercase tracking-widest">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
        <span>Facebook</span>
      </a>
    </div>
    <div class="text-[9px] uppercase tracking-widest text-charcoal/50 leading-relaxed">
      IKAL Spa & Wellness © 2026<br/>
      Fisioterapeuta Grecia Lamar
    </div>
  </div>
</div>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const menuOverlay = document.getElementById("mobile-menu-overlay");
  const line1 = document.getElementById("hamburger-line-1");
  const line2 = document.getElementById("hamburger-line-2");
  const navLinks = document.querySelectorAll(".mobile-nav-link");

  let isOpen = false;

  const toggleMenu = () => {
    isOpen = !isOpen;
    
    if (isOpen) {
      // Open State
      menuOverlay.classList.remove("pointer-events-none", "opacity-0");
      menuOverlay.classList.add("opacity-100");
      
      // Hamburger Morph to X
      line1.style.transform = "rotate(45deg) translate(2.5px, 2.5px)";
      line2.style.transform = "rotate(-45deg) translate(2.5px, -2.5px)";
      
      // Staggered Link Entry
      navLinks.forEach((link, i) => {
        setTimeout(() => {
          link.classList.remove("translate-y-12", "opacity-0");
          link.classList.add("translate-y-0", "opacity-100");
        }, 100 + i * 60);
      });
    } else {
      // Close State
      menuOverlay.classList.add("pointer-events-none", "opacity-0");
      menuOverlay.classList.remove("opacity-100");
      
      // Hamburger Restore
      line1.style.transform = "none";
      line2.style.transform = "none";
      
      // Reset Links
      navLinks.forEach((link) => {
        link.classList.add("translate-y-12", "opacity-0");
        link.classList.remove("translate-y-0", "opacity-100");
      });
    }
  };

  menuBtn?.addEventListener("click", toggleMenu);

  // Close menu when clicking on any navigation link
  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (isOpen) toggleMenu();
    });
  });
</script>
